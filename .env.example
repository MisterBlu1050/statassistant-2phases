# Domaine public pour certificat HTTPS automatique Caddy (ex: stats.xl-ai.eu)
DOMAIN=localhost

# Optionnel en dev local ; à définir obligatoirement en production
STAT_API_KEY=
STAT_ADMIN_KEY=change-me-strong-admin-secret

# Expiration automatique ZDR des sessions en mémoire vive (minutes)
SESSION_TTL_MINUTES=30
